# Copy to .env and fill in. Never commit .env. Full reference: docs/configuration.md

# --- Telegram -------------------------------------------------------------------
# Required. Token from @BotFather (/newbot).
TELEGRAM_BOT_TOKEN=
# Required. Comma-separated Telegram user IDs with the admin role. Locked: they cannot be
# demoted or removed from chat. Unknown users see their ID when they send /start.
TELEGRAM_ADMIN_USER_IDS=
# Optional. Users allowed from the start, as viewers (admins can promote them with /admin role).
TELEGRAM_ALLOWED_USER_IDS=
# Optional. Group/supergroup chat IDs (negative numbers) where the bot answers. Private chats
# always work. Being in an allowed group does NOT grant access: the user must be allowed too.
TELEGRAM_ALLOWED_CHAT_IDS=
# Optional. Webhook mode instead of long polling: public https URL (path included) that your
# reverse proxy forwards to the container's port 8080. Requires TELEGRAM_WEBHOOK_SECRET.
TELEGRAM_WEBHOOK_URL=
# 1-256 characters from A-Z a-z 0-9 _ -  (e.g. `openssl rand -hex 32`)
TELEGRAM_WEBHOOK_SECRET=

# --- GitHub: either a token, or a GitHub App (the App wins if both are set) -----------
# Fine-grained personal access token, scoped to the repositories the bot manages.
GITHUB_TOKEN=
# GitHub App: all three are required together. The key may be the PEM text (with \n escapes)
# or a path to the .pem file. Needs the extra: pip install 'telegram-github-bot[github-app]'.
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_INSTALLATION_ID=

# --- Application ------------------------------------------------------------------
# Repositories managed from the start (cannot be removed from chat), e.g. owner/repo-a,owner/repo-b
DEFAULT_REPOSITORIES=
# IANA time zone used to show dates.
DEFAULT_TIMEZONE=America/Bogota
# DEBUG, INFO, WARNING or ERROR. Logs are JSON on stdout, with secrets redacted.
LOG_LEVEL=INFO
# sqlite:///relative/path.db or sqlite:////absolute/path.db. Empty = in memory (changes made
# from Telegram are lost on restart). docker-compose.yml defaults it to /data/bot.db.
DATABASE_URL=
# Commands per user per minute.
RATE_LIMIT_REQUESTS_PER_MINUTE=30
# Longer replies are sent as plain text, cut to this length (Telegram's hard limit is 4096).
MAX_MESSAGE_LENGTH=4000
# UI language: a file in src/tgbot/locales/ (es by default).
BOT_LOCALE=es
