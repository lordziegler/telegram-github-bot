# Copia este archivo a .env y rellénalo. Nunca subas .env a git.
# Referencia completa: docs/configuration.md

# --- Telegram -------------------------------------------------------------------
# Obligatorio. Token de @BotFather (/newbot).
TELEGRAM_BOT_TOKEN=
# Obligatorio. IDs de usuario de Telegram con rol admin, separados por comas. Están fijados:
# no se les puede quitar el rol ni el acceso desde el chat. Un usuario desconocido ve su ID
# al enviar /start.
TELEGRAM_ADMIN_USER_IDS=
# Opcional. Usuarios autorizados desde el inicio, como viewer (un admin puede subirles el rol
# con /admin role).
TELEGRAM_ALLOWED_USER_IDS=
# Opcional. IDs de grupos o supergrupos (números negativos) donde el bot responde. Los chats
# privados funcionan siempre. Estar en un grupo permitido NO da acceso: el usuario también
# tiene que estar autorizado.
TELEGRAM_ALLOWED_CHAT_IDS=
# Opcional. Modo webhook en lugar de long polling: URL https pública (con su ruta) que tu
# proxy inverso reenvía al puerto 8080 del contenedor. Requiere TELEGRAM_WEBHOOK_SECRET.
TELEGRAM_WEBHOOK_URL=
# De 1 a 256 caracteres entre A-Z a-z 0-9 _ -  (p. ej. `openssl rand -hex 32`)
TELEGRAM_WEBHOOK_SECRET=

# --- GitHub: un token o una GitHub App (si hay ambos, gana la App) ---------------------
# Personal access token fine-grained, limitado a los repositorios que gestiona el bot.
GITHUB_TOKEN=
# GitHub App: las tres variables van juntas. La clave puede ser el texto PEM (con \n
# escritos tal cual) o la ruta al archivo .pem. Necesita el extra:
# pip install 'telegram-github-bot[github-app]'.
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_INSTALLATION_ID=

# --- Aplicación -------------------------------------------------------------------
# Repositorios gestionados desde el inicio (no se pueden quitar desde el chat),
# p. ej. owner/repo-a,owner/repo-b
DEFAULT_REPOSITORIES=
# Zona horaria IANA para mostrar fechas.
DEFAULT_TIMEZONE=America/Bogota
# DEBUG, INFO, WARNING o ERROR. Los logs salen en JSON por stdout, con los secretos ocultos.
LOG_LEVEL=INFO
# sqlite:///ruta/relativa.db o sqlite:////ruta/absoluta.db. Vacío = en memoria (lo que se
# cambie desde Telegram se pierde al reiniciar). docker-compose.yml usa /data/bot.db por defecto.
DATABASE_URL=
# Comandos por usuario y por minuto.
RATE_LIMIT_REQUESTS_PER_MINUTE=30
# Las respuestas más largas se envían como texto plano, cortadas a esta longitud
# (el máximo de Telegram es 4096).
MAX_MESSAGE_LENGTH=4000
# Idioma de la interfaz: un archivo de src/tgbot/locales/ (es por defecto).
BOT_LOCALE=es
